# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# URL + publishable key are safe to expose (RLS is the boundary).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — bypasses RLS; used by /api/leads. Never NEXT_PUBLIC_, never committed.
SUPABASE_SECRET_KEY=

# Alerts (Phase 9)
# Shared secret guarding /api/alerts/run — Vercel Cron sends it automatically
# when the same value exists as a Vercel env var. Generate: openssl rand -hex 24
CRON_SECRET=
# Resend API key (Sending access) for alert digests from alerts@discoverdfw.com.
RESEND_API_KEY=

# Optional overrides
# NEXT_PUBLIC_SITE_URL=https://www.discoverdfw.com
# MLS_PROVIDER=mock
