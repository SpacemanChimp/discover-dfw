# Discover DFW — environment variables
# Copy to .env.local for development. Never commit real values; .env*
# (except this file) is gitignored. Production values live in
# Vercel → Settings → Environment Variables.

# ---- Supabase (auth + database) ----
# From Supabase Dashboard → Project Settings → API Keys.
# URL + publishable key are safe to expose (RLS is the boundary).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY — bypasses RLS; used for lead tables, lead emails, and the
# alert sweep. Never NEXT_PUBLIC_, never committed.
SUPABASE_SECRET_KEY=

# ---- MLS (Trestle IDX Plus / NTREIS) ----
# "trestle" serves live inventory; unset/"mock" serves fictional data
# (mock mode also re-noindexes every search surface automatically).
MLS_PROVIDER=trestle
# SERVER-ONLY. From Trestle → Products → <product> → Feeds → Manage.
# The credential expires yearly — RESET there, update here + Vercel.
# (TRESTLE_CLIENT_ID / TRESTLE_CLIENT_SECRET are accepted as aliases;
#  TRESTLE_TOKEN_URL / TRESTLE_ODATA_BASE_URL override the endpoints.)
# Smoke test: node scripts/trestle-smoke.mjs [city]
TRESTLE_API_ID=
TRESTLE_API_PASSWORD=

# ---- Email (Resend) ----
# SERVER-ONLY. Sending key; mail goes out as alerts@discoverdfw.com.
# Without it, every send degrades to a server log (nothing crashes).
RESEND_API_KEY=
# Internal lead notifications (showing requests, questions) go here —
# the owner/broker/team inbox. Unset = guide notifications are skipped;
# user confirmation emails still send.
LEAD_NOTIFY_EMAIL=
# Dev safety: outside production, all emails DRY-RUN (logged, not sent)
# even with a real key. Set to 1 only to deliberately send from dev.
EMAIL_SEND_IN_DEV=

# ---- CRM (Follow Up Boss) ----
# SERVER-ONLY. From FUB → Admin → API → API Keys. Unset = CRM push is
# disabled (leads still store in Supabase and email the guide).
# Vendors must register the system first:
# https://apps.followupboss.com/system-registration
FUB_API_KEY=
# Registered system identifiers — sent as X-System / X-System-Key headers.
# Registered 2026-07-15 as "A-Field-Guide-To-North-Texas-Real-Estate";
# the key was issued by FUB at registration (server-only, never commit).
FUB_SYSTEM=A-Field-Guide-To-North-Texas-Real-Estate
FUB_SYSTEM_KEY=
# Lead source label in FUB. Applied to NEW contacts only — FUB never
# overwrites an existing contact's source attribution on /events.
FUB_SOURCE=DiscoverDFW
# Dev safety (mirrors email): outside production every push DRY-RUNs
# (logged, not sent) even with a real key. Set FUB_SEND_IN_DEV=1 to
# deliberately send from dev. FUB_DRY_RUN=1 forces dry-run ANYWHERE —
# the production kill switch.
FUB_DRY_RUN=
FUB_SEND_IN_DEV=

# ---- Admin ----
# Comma-separated emails allowed into /admin/leads (the Lead Desk).
# A visitor must hold a real session AND be on this list; unset = the
# admin surface 404s for everyone. Upgrade path: profiles.role column.
ADMIN_EMAILS=

# ---- Cron ----
# Shared secret guarding /api/alerts/run — Vercel Cron sends it
# automatically when the same value exists as a Vercel env var.
# Generate: openssl rand -hex 24
CRON_SECRET=

# ---- Content Intelligence Loop (scripts only — none used at runtime yet) ----
# SERVER-ONLY. Used by scripts/content/review-draft only (Claude drafts
# candidate summaries/captions — output is never published without human
# approval). Model pinned so upgrades are deliberate.
ANTHROPIC_API_KEY=
CONTENT_CLAUDE_MODEL=claude-opus-4-8
# Photo provider etiquette/keys. Wikimedia requires a descriptive UA with
# contact info (e.g. "DiscoverDFW/1.0 (you@example.com)"); Openverse asks
# for a contact email. Pexels/Unsplash adapters disable themselves when
# their keys are unset.
WIKIMEDIA_USER_AGENT=
OPENVERSE_CONTACT_EMAIL=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Google Places is DISABLED for v1 — the flag exists so enabling it later
# is a deliberate, reviewed act. Leave false.
CONTENT_ENABLE_GOOGLE_PLACES=false
GOOGLE_PLACES_API_KEY=
# Safety rails for content jobs: dry-run forces every job to log instead
# of write; auto-publish is read but ONLY false is honored in production.
CONTENT_INTELLIGENCE_DRY_RUN=true
CONTENT_INTELLIGENCE_AUTO_PUBLISH=false
# Dev-only: render a data:-URI mock into every editorial photo slot so the
# approved-photo path can be checked without DB rows. Ignored in production.
CONTENT_EDITORIAL_PHOTO_MOCK=

# Optional overrides
# NEXT_PUBLIC_SITE_URL=https://www.discoverdfw.com
